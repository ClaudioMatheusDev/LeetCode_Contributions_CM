## Ignore Visual Studio temporary files, build results, and files generated by add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.env

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Oo]bj/
[Bb]in/
artifacts/
.artifacts/

# Visual Studio cache/options directory
.vs/

# Test and generated files
[Tt]est[Rr]esult*/
*.trx
*.log
*.cache
*.pdb
*.obj
*.tmp
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# .NET generated files
project.lock.json
project.fragment.lock.json